# ===== picsense 配置 =====
# 使用方法：复制为 .env 并填入真实值（.env 已在 .gitignore 中，绝不提交）

# 默认使用的 provider（openai / qwen / kimi）
DEFAULT_PROVIDER=openai

# ===== OpenAI（首版推荐，支持世界最强多模态模型）=====
# 使用 OpenAI Responses API（/v1/responses 原生格式）
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-5.6-sol
# 可选：自定义 base URL（如代理或兼容网关）。
# 代码会自动规范化：不带 /v1 则补上，带则原样使用。
# OPENAI_BASE_URL=https://api.openai.com

# ===== Qwen（后续支持）=====
# QWEN_API_KEY=
# QWEN_MODEL=qwen-vl-max
# QWEN_BASE_URL=

# ===== Kimi（后续支持）=====
# KIMI_API_KEY=
# KIMI_MODEL=moonshot-v1-vision
# KIMI_BASE_URL=

# ===== 通用参数（可选，均有默认值）=====
# 单张图片大小上限（MB）
# MAX_IMAGE_MB=5
# 视觉模型请求超时（毫秒）
# TIMEOUT_MS=300000
