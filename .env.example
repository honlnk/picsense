# ===== picsense 配置 =====
# 使用方法：复制为 .env 并填入真实值（.env 已在 .gitignore 中，绝不提交）

# 默认使用的 provider（openai / chat / anthropic；qwen / kimi 规划中）
DEFAULT_PROVIDER=openai

# ===== OpenAI（首版推荐，支持世界最强多模态模型）=====
# 使用 OpenAI Responses API（/v1/responses 原生格式）
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-5.6-sol
# 可选：自定义 base URL（如代理或兼容网关）。
# 代码会自动规范化：不带 /v1 则补上，带则原样使用。
# OPENAI_BASE_URL=https://api.openai.com

# ===== Chat Completions（通用 OpenAI 兼容协议）=====
# 适配腾讯 Coding Copilot、DeepSeek 官方、Qwen 及绝大多数 OpenAI 兼容网关。
# 内部始终走流式（SSE），因此也兼容强制流式的端点（如腾讯）。
# CHAT_API_KEY=ck-xxx
# CHAT_MODEL=hy4-preview
# 腾讯示例：CHAT_BASE_URL=https://copilot.tencent.com/v2
# CHAT_BASE_URL=

# ===== Anthropic（Messages API 协议）=====
# 适配 Anthropic 官方及 anthropic 协议兼容端点（如 DeepSeek 官方 /anthropic）。
# 图片自动转 base64（协议只收 base64 形态）。
# ANTHROPIC_API_KEY=sk-xxx
# ANTHROPIC_MODEL=claude-sonnet-4
# DeepSeek 示例：ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic（模型用 deepseek-v4-flash-vision-exp）
# ANTHROPIC_BASE_URL=

# ===== Qwen（后续支持）=====
# QWEN_API_KEY=
# QWEN_MODEL=qwen-vl-max
# QWEN_BASE_URL=

# ===== Kimi（后续支持）=====
# KIMI_API_KEY=
# KIMI_MODEL=moonshot-v1-vision
# KIMI_BASE_URL=

# ===== 通用参数（可选，均有默认值）=====
# 单张图片大小上限（MB）
# MAX_IMAGE_MB=5
# 视觉模型请求超时（毫秒）
# TIMEOUT_MS=300000

# ===== 视频识别参数（可选，均有默认值）=====
# 单个视频大小上限（MB）
# MAX_VIDEO_MB=100
# 视频抽帧的最大帧数（默认 30，覆盖大多数 30 秒以内的短视频）
# VIDEO_MAX_FRAMES=30
# 视频抽帧的采样率——每秒抽几帧（默认 1）
# VIDEO_FPS=1
