{
  "name": "picsense",
  "version": "0.1.0",
  "description": "本地图片识别 MCP，让单模态基座模型获得多模态视觉能力。支持多轮迭代识别。",
  "type": "module",
  "license": "Apache-2.0",
  "author": "honlnk",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vision",
    "image-recognition",
    "multimodal",
    "ai-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "picsense": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:session": "tsx scripts/smoke-session.ts",
    "smoke:tools": "tsx scripts/smoke-tools.ts",
    "e2e": "pnpm build && tsx scripts/e2e-client.ts",
    "sim": "pnpm build && tsx scripts/zcode-sim.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
