{
  "name": "@honlnk/picsense",
  "version": "0.1.0",
  "description": "A local MCP server that gives unimodal LLMs multimodal vision — image/video recognition with multi-turn iterative analysis.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "honlnk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honlnk/picsense.git"
  },
  "homepage": "https://github.com/honlnk/picsense#readme",
  "bugs": {
    "url": "https://github.com/honlnk/picsense/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "vision",
    "image-recognition",
    "video-recognition",
    "multimodal",
    "llm-tools",
    "ai-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "picsense": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:session": "tsx scripts/smoke-session.ts",
    "smoke:tools": "tsx scripts/smoke-tools.ts",
    "smoke:video": "tsx scripts/smoke-video.ts",
    "e2e": "pnpm build && tsx scripts/e2e-client.ts",
    "sim": "pnpm build && tsx scripts/zcode-sim.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ffmpeg-static": "^5.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["ffmpeg-static"]
  }
}
